pkgname=m3vpn-bin
pkgver=0.2.4
pkgrel=1
pkgdesc="Material 3 client for Xray, sing-box, Reality, Hysteria 2 and AmneziaWG"
arch=('x86_64')
url="https://github.com/nikitaakbaev/m3vpn"
license=('MIT')
depends=('webkit2gtk-4.1' 'gtk3' 'libappindicator')
provides=('m3vpn')
conflicts=('m3vpn')
install=m3vpn-bin.install
source=("m3vpn-${pkgver}-1-x86_64.pkg.tar.zst::${url}/releases/download/v${pkgver}/m3vpn-${pkgver}-1-x86_64.pkg.tar.zst")
sha256sums=('REPLACE_WITH_SHA256')

package() {
  bsdtar -xf "${srcdir}/m3vpn-${pkgver}-1-x86_64.pkg.tar.zst" -C "${pkgdir}" usr
}
