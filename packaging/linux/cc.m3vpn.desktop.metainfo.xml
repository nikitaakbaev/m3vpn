<component type="desktop-application">
  <id>cc.m3vpn.desktop</id>
  <name>m3vpn</name>
  <summary>Material 3 client for Xray and sing-box</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>LicenseRef-proprietary</project_license>
  <description>
    <p>
      m3vpn is a Linux desktop proxy client for full Xray configurations,
      share links, subscriptions, AmneziaWG, Hysteria 2 and TUIC. It uses a
      permanent front proxy with hot-switch, automatic fastest-server selection
      and an optional TUN mode through a privileged helper.
    </p>
  </description>
